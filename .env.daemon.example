# AUTO-FIX DAEMON — Cohort Fundamentals
# Copie este arquivo para .env.daemon e preencha com suas chaves reais
# NUNCA commite o .env.daemon no git!

SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
UAZAPI_BASE_URL=https://your-instance.uazapi.com
UAZAPI_TOKEN=your-uazapi-token-here
NOTIFICATION_NUMBER=5500000000000
CLAUDE_MODEL=sonnet
AUTO_FIX_PORT=7777
POLL_INTERVAL=30
MIN_CONFIDENCE=0.8
MAX_FIXES_PER_HOUR=3
